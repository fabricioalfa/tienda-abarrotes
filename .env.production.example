# ==========================================================================
#  Plantilla de variables de entorno para PRODUCCION (Hostinger / hPanel)
#
#  Uso:
#    1. Copia este archivo a .env  ->  cp .env.production.example .env
#    2. Rellena los valores marcados con  <- OBLIGATORIO
#    3. Genera la llave  ->  php artisan key:generate
#    4. Crea la base de datos en hPanel y ejecuta:
#         php artisan migrate --force
#         php artisan db:seed --force      (solo la primera vez, ver abajo)
# ==========================================================================

APP_NAME="Carnicería Colcapirhua"

# --- OBLIGATORIO: "production" activates HTTPS enforcement and disables debug
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.com          # <- OBLIGATORIO (sin barra final)

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

# --- OBLIGATORIO: php artisan key:generate
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# En produccion no necesitas el log de nivel debug: genera ruido y crece rapido.
LOG_LEVEL=warning

# --- Base de datos MySQL que creas en hPanel -> Bases de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                       # <- OBLIGATORIO (nombre de la BD)
DB_USERNAME=                       # <- OBLIGATORIO (usuario de la BD)
DB_PASSWORD=                       # <- OBLIGATORIO

# Sesiones y cache en base de datos: requiere las tablas `sessions` y `cache`,
# que crea `php artisan migrate`. En un VPS con Redis puedes usar
# CACHE_STORE=redis y SESSION_DRIVER=redis en su lugar.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# IMPORTANTE con APP_ENV=production: obliga a que la cookie de sesion solo
# viaje por HTTPS. Sin esto, la cookie de sesion puede enviarse en claro.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Correo. En Hostinger el SMTP suele ser mail.tu-dominio.com
# MAIL_MAILER=log   <- por defecto solo escribe en storage/logs, no envia nada
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-dominio.com       # <- OBLIGATORIO si envias correo
MAIL_PORT=587
MAIL_USERNAME=                       # <- OBLIGATORIO si envias correo
MAIL_PASSWORD=                       # <- OBLIGATORIO si envias correo
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
#  Credenciales del primer administrador
#
#  Solo se usan al ejecutar `php artisan db:seed`. El seeder se NEGA a correr
#  en produccion si faltan, o si la contrasena es "password" o menor de 8
#  caracteres.
#
#  Destruye estas variables despues del primer despliegue:
#    php artisan db:seed --force
#    (luego borra ADMIN_PASSWORD / CASHIER_PASSWORD del .env)
#
#  Para cambiar la contrasena mas adelante, usa la app en /perfil.
# ==========================================================================
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@tu-dominio.com        # <- OBLIGATORIO
ADMIN_PASSWORD=                          # <- OBLIGATORIO (min. 8 caracteres)

# El usuario de caja es OPCIONAL: si no lo quieres crear desde el seed, deja
# CASHIER_EMAIL vacio y el seeder no creara ninguna cuenta de caja. Despues
# puedes darlas de alta desde la app en /usuarios.
CASHIER_NAME="Usuario Caja"
CASHIER_EMAIL=
CASHIER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
